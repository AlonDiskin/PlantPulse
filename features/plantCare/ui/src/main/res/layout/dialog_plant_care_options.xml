<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="onLightMeterClick"
            type="android.view.View.OnClickListener" />
        <variable
            name="onWaterReminderClick"
            type="android.view.View.OnClickListener" />
        <variable
            name="onCloseClick"
            type="android.view.View.OnClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        tools:theme="@style/Theme.Material3.DayNight">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Plant Care"
                android:textColor="?attr/colorOnSurface" />

            <!-- Light Meter Option -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_light_meter"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="250dp"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:gravity="start|center_vertical"
                android:onClick="@{onLightMeterClick}"
                android:text="Light Meter"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:icon="@drawable/wb_sunny_24dp"
                app:iconPadding="16dp"
                app:iconSize="24dp" />

            <!-- Water Reminder Option -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_water_reminder"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="250dp"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:gravity="start|center_vertical"
                android:onClick="@{onWaterReminderClick}"
                android:text="Water Reminder"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:icon="@drawable/water_drop_24dp"
                app:iconPadding="16dp"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:onClick="@{onCloseClick}"
                android:text="Close" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
